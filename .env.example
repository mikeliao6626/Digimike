# ═══════════════════════════════════════════════════════
# Digimike Sub-ERP — 环境变量示例
# 复制此文件为 .env 并填入真实值，切勿提交 .env 到 Git！
# ═══════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────
APP_ENV=development                        # development | production
APP_SECRET_KEY=your-super-secret-key-here  # JWT 签名密钥，生产环境用随机 64 位字符串
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL (业务数据库) ──────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digimike_erp
POSTGRES_USER=digimike
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql+asyncpg://digimike:your-postgres-password@localhost:5432/digimike_erp

# ── Qdrant (向量数据库 — AI Memory) ─────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                            # 使用 Qdrant Cloud 时填写
QDRANT_COLLECTION_WEIBO=mike_weibo_memory  # 微博内容向量集合名称

# ── Google OAuth 2.0 (联合登录) ─────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Google Gemini API ────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ── LangChain / LangSmith (可选，用于 Agent 追踪) ────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=digimike-sub-erp
